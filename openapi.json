{"openapi":"3.1.0","info":{"title":"CriptoVision API","description":"API REST para cadastro de usuários, autenticação JWT, registro de transações e análise de carteiras de criptomoedas.","contact":{"name":"Alexandre Vital","url":"https://github.com/xandaodev"},"version":"1.0.0"},"externalDocs":{"description":"Código-fonte do CriptoVision","url":"https://github.com/xandaodev/gerenciamento_investimentos_cripto"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"tags":[{"name":"Autenticação","description":"Cadastro de usuários e emissão de tokens JWT."},{"name":"Carteira","description":"Resumo, patrimônio e simulações da carteira autenticada."},{"name":"Transações","description":"Cadastro, consulta, alteração e exclusão de transações."},{"name":"Análises","description":"Indicadores agregados das transações do usuário autenticado."}],"paths":{"/transacoes/{id}":{"get":{"tags":["Transações"],"summary":"Buscar transação por ID","description":"Retorna uma transação do usuário autenticado.","operationId":"buscarTransacaoPorId","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"Transação encontrada.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Transacao"}}}},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"404":{"description":"Transação não encontrada para este usuário.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["Transações"],"summary":"Atualizar transação","description":"Substitui os dados de uma transação sem permitir que o histórico fique inconsistente.","operationId":"atualizarTransacao","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"description":"Novos dados da operação.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransacaoRequest"},"example":{"ticker":"BTC","quantidade":0.02,"precoUnitario":62500.0,"tipo":"COMPRA"}}},"required":true},"responses":{"200":{"description":"Transação atualizada com sucesso.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Transacao"}}}},"400":{"description":"Dados inválidos ou ticker inexistente.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"404":{"description":"Transação não encontrada para este usuário.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"409":{"description":"A alteração tornaria o histórico inconsistente.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]},"delete":{"tags":["Transações"],"summary":"Excluir transação","description":"Exclui uma transação quando a remoção não torna o histórico inconsistente.","operationId":"excluirTransacao","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"204":{"description":"Transação excluída com sucesso."},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"404":{"description":"Transação não encontrada para este usuário.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"409":{"description":"A exclusão tornaria o histórico inconsistente.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]}},"/transacoes":{"get":{"tags":["Transações"],"summary":"Listar transações","d