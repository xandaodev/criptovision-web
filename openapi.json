e":"number","format":"double"},"example":65000.0}],"responses":{"200":{"description":"Simulação realizada com sucesso.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimulacaoDCA"}}}},"400":{"description":"Parâmetros ausentes ou com tipos inválidos.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"500":{"description":"O histórico da carteira está inconsistente.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]}},"/carteira/resumo":{"get":{"tags":["Carteira"],"summary":"Obter resumo da carteira","description":"Reconstrói a carteira e retorna valores atuais, PNL e variação em 24 horas.","operationId":"obterResumoCarteira","responses":{"200":{"description":"Resumo calculado com sucesso.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResumoCarteira"}}}},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}},"500":{"description":"Não foi possível reconstruir ou calcular a carteira.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]}},"/analise/aportes-por-moeda":{"get":{"tags":["Análises"],"summary":"Calcular aportes por moeda","description":"Agrupa as compras do usuário e soma o valor aportado em cada ativo.","operationId":"obterAportesPorMoeda","responses":{"200":{"description":"Aportes agrupados com sucesso.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AportePorMoeda"}}}}},"401":{"description":"Token JWT ausente, inválido ou expirado.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/ProblemaApi"}}}}},"security":[{"bearerAuth":[]}]}}},"components":{"schemas":{"TransacaoRequest":{"type":"object","description":"Dados utilizados para cadastrar ou atualizar uma transação.","properties":{"ticker":{"type":"string","description":"Símbolo do ativo. É normalizado para letras maiúsculas.","example":"BTC","maxLength":20,"minLength":0,"pattern":"^[A-Z0-9]+$"},"quantidade":{"type":"number","description":"Quantidade negociada.","example":0.015,"minimum":0},"precoUnitario":{"type":"number","description":"Preço unitário do ativo na operação.","example":64000.0,"minimum":0},"tipo":{"type":"string","description":"Natureza da operação.","enum":["COMPRA","VENDA"],"example":"COMPRA"}},"required":["precoUnitario","quantidade","ticker","tipo"]},"Transacao":{"type":"object","description":"Operação de compra ou venda registrada pelo usuário autenticado.","properties":{"ticker":{"type":"string","description":"Ticker do ativo.","example":"BTC"},"quantidade":{"type":"number","description":"Quantidade negociada.","example":0.015},"precoUnitario":{"type":"number","description":"Preço unitário informado na operação.","example":64000.0},"data":{"type":"string","format":"date-time","description":"Data e hora de criação da transação.","example":"2026-08-05T17:30:00","readOnly":true},"tipo":{"type":"string","description":"Tipo da operação.","enum":["COMPRA","VENDA","COMPRA","VENDA"],"example":"COMPRA"},"id":{"type":"integer","format":"int64","description":"Identificador da transação.","example":42,"readOnly":true}}},"ErroCampo":{"type":"object","description":"Erro de validação associado a um campo da requisição.","properties":{"campo":{"type":"string","description":"Nome do campo inválido.","example":"senha"},"mensagem":{"type":"string","description":"Mensagem explicando a restrição violada.","example":"A senha deve possuir entre 8 e 64 caracteres."}}},"ProblemaApi":{"type":"object","description":"Resposta padronizada de erro seguindo o formato Problem Details.","properties":{"type":{"type":"string","format":"uri","description":"Identificador do tipo de problema.","example":"about:blank"},"title":{"type":"string","description":"Título resumido da categoria do erro.","example":"Dados inválidos"},"status":{"type":"integer","format":"int32","description":"Código HTTP da resposta.","example":400},"detail":{"type":"string","description":"Explicação legível do problema.","example":"Um ou mais campos possuem valores inválidos."},"instance":{"type":"string","format":"uri","description":"Caminho da requisição que gerou o erro.","example":"/auth/register"},"dataHora":{"type":"string","format":"date-time","description":"Data e hora UTC em que o erro foi produzido.","example":"2026-08-05T20:00:00Z"},"erros":{"type":"array","description":"Erros associados a campos específicos. Presente em falhas de validação.","items":{"$ref":"#/components/schemas/ErroCampo"}}}},"DadosCadastroUsuario":{"type":"object","description":"Dados necessários para criar uma conta no CriptoVision.","properties":{"login":{"type":"string","description":"Login único. É normalizado para letras minúsculas.","example":"alexandre.dev","maxLength":100,"minLength":3,"pattern":"^[a-zA-Z0-9._-]+$"},"senha":{"type":"string","description":"Senha com 8 a 64 caracteres.","example":"SenhaSegura@2026","maxLength":64,"minLength":8,"writeOnly":true}},"required":["login","senha"]},"UsuarioCadastrado":{"type":"object","description":"Dados públicos retornados após a criação de uma conta.","properties":{"id":{"type":"integer","format":"int64","description":"Identificador do usuário.","example":1},"login":{"type":"string","description":"Login normalizado do usuário.","example":"alexandre.dev"}}},"DadosAutenticacao":{"type":"object","description":"Credenciais utilizadas para autenticar um usuário.","properties":{"login":{"type":"string","description":"Login do usuário cadastrado.","example":"alexandre","minLength":1},"senha":{"type":"string","description":"Senha do usuário.","example":"SenhaSegura@2026","minLength":1,"writeOnly":true}},"required":["login","senha"]},"TokenJwt":{"type":"object","description":"Token JWT utilizado no cabeçalho Authorization das rotas protegidas.","properties":{"token":{"type":"string","description":"Token de autenticação no formato JWT.","example":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo.assinatura"}}},"SimulacaoVenda":{"type":"object","description":"Resultado de uma simulação de venda de toda a posição.","properties":{"lucroEstimado":{"type":"number","format":"double","description":"Lucro ou prejuízo estimado em USD.","example":325.0},"porcentagemLucro":{"type":"number","format":"double","description":"Lucro ou prejuízo estimado em percentual.","example":22.03},"valorTotalFicticio":{"type":"number","format":"double","description":"Valor da posição no preço-alvo.","example":1800.0},"valorTotalAtual":{"type":"number","format":"double","description":"Valor atual da posição.","example":1625.0}}},"SimulacaoDCA":{"type":"object","description":"Resultado de uma simulação de novo aporte e preço médio.","properties":{"qtdComprada":{"type":"number","format":"double","description":"Quantidade que o aporte compraria.","example":0.0076923},"saldoAtual":{"type":"number","format":"double","description":"Saldo atual do ativo.","example":0.025},"novoSaldoTotal":{"type":"number","format":"double","description":"Saldo após o aporte simulado.","example":0.0326923},"pmAtual":{"type":"number","format":"double","description":"Preço médio atual.","example":59000.0},"novoPM":{"type":"number","format":"double","description":"Novo preço médio estimado.","example":60411.76},"diferencaPM":{"type":"number","format":"double","description":"Variação percentual do preço médio.","example":2.39},"valorizacaoNecessaria":{"type":"number","format":"double","description":"Valorização necessária para atingir o ponto de equilíbrio.","example":-7.06}}},"ResumoAtivo":{"type":"object","description":"Indicadores calculados para um ativo presente na carteira.","properties":{"ticker":{"type":"string","description":"Ticker do ativo.","example":"BTC"},"saldo":{"type":"number","format":"double","description":"Quantidade atual do ativo.","example":0.025},"precoAtual":{"type":"number","format":"double","description":"Preço atual do ativo em USD.","example":65000.0},"precoMedio":{"type":"number","format":"double","description":"Preço médio de aquisição em USD.","example":59000.0},"valorTotalUSD":{"type":"number","format":"double","description":"Valor atual da posição em USD.","example":1625.0},"porcentagemPNL":{"type":"number","format":"double","description":"Percentual de lucro ou prejuízo não realizado.","example":10.17},"variacao24h":{"type":"number","format":"double","description":"Variação do ativo nas últimas 24 horas, em percentual.","example":2.35}}},"ResumoCarteira":{"type":"object","description":"Resumo consolidado da carteira do usuário autenticado.","properties":{"valorTotalCarteira":{"type":"number","format":"double","description":"Valor atual total da carteira em USD.","example":3850.75},"pnlGeral":{"type":"number","format":"double","description":"Lucro ou prejuízo não realizado total em USD.","example":425.3},"variacao24hCarteira":{"type":"number","format":"double","description":"Variação estimada da carteira nas últimas 24 horas.","example":1.82},"ativos":{"type":"array","description":"Detalhamento dos ativos com saldo positivo.","items":{"$ref":"#/components/schemas/ResumoAtivo"}}}},"AportePorMoeda":{"type":"object","description":"Valor total aportado em compras agrupado por ativo.","properties":{"ticker":{"type":"string","description":"Ticker do ativo.","example":"BTC"},"totalAportado":{"type":"number","description":"Total aportado no ativo.","example":12500.0}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"Informe o token JWT retornado por POST /auth/login.","scheme":"bearer","bearerFormat":"JWT"}}}}